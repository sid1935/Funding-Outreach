# --- Required everywhere (local .env, Vercel, GitHub Actions) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Written by `node get_gmail_token.js`
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Vercel only ---
# Any long random string. Schedulers send it as "Authorization: Bearer <value>" to /api/run.
CRON_SECRET=
# Inbox that the dashboard's Approve button sends to in demo mode (not a secret).
DEMO_TO=
# Optional: set SEND_MODE=live to send to real recipients; this also requires APPROVAL_PIN.
# SEND_MODE=live
# APPROVAL_PIN=

# --- Hunter (contact lookup; see README) ---
HUNTER_API_KEY=
# HUNTER_MAX_PER_RUN=5        # credits spent per pipeline run
# HUNTER_MIN_CONFIDENCE=70    # ignore addresses below this confidence

# --- Optional tuning ---
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_DRAFT_MODEL=
# WINDOW_HOURS=26
# MIN_SCORE=50          # testing only: overrides the thesis minimum score for one run
